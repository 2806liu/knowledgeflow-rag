      "id": "F-attendance",
      "kind": "short_text_pdf",
      "definition": "合成《实验室考勤制度》：周一至周五每天4次打卡，上午、下午、晚上各一次及离开时一次；请假另有章节。",
      "gold_key_points": [
        "实验室考勤管理",
        "周一至周五每天4次",
        "三个时段加离开时一次",
        "请假规则另有规定"
      ],
      "public": true
    },
