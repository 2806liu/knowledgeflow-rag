# 复制为 .env；只在本地填写模型密钥，不提交真实配置。
OPENAI_API_KEY=

# 兼容 Embedding 接口地址；需要向量检索时填写，通常以 /v1 结尾。
STUDYFLOW_EMBEDDING_BASE_URL=
STUDYFLOW_EMBEDDING_MODEL=text-embedding-3-small

# Enable only after Qdrant is running and OPENAI_API_KEY is filled in.
STUDYFLOW_VECTOR_ENABLED=false
STUDYFLOW_QDRANT_URL=http://127.0.0.1:6333
STUDYFLOW_QDRANT_COLLECTION=knowledgeflow_chunks_v1

# Keep the existing lexical retrieval until its alternatives beat it on new labels.
STUDYFLOW_RETRIEVAL_STRATEGY=bm25_idf_v2
# Optional experiment: hybrid_rrf_v1. Keep candidate pools larger than final Top-4.
STUDYFLOW_RETRIEVAL_HYBRID_CANDIDATE_K=32
STUDYFLOW_RETRIEVAL_HYBRID_RRF_K=60
STUDYFLOW_RETRIEVAL_HYBRID_MAX_HITS_PER_DOCUMENT=2
# Optional local CPU cross-encoder: install .[reranker], then prepare models.
# Disabled by default; restart the service after changing this switch.
STUDYFLOW_RERANKER_ENABLED=false
STUDYFLOW_RERANKER_MODEL_DIR=.studyflow/reranker_models
STUDYFLOW_RERANKER_CANDIDATE_K=32
STUDYFLOW_RERANKER_BATCH_SIZE=8
STUDYFLOW_RERANKER_MAX_LENGTH=512
# fallback returns exactly the old retrieval ranking; error returns 503/502.
STUDYFLOW_RERANKER_FAILURE_POLICY=fallback
# Expand only split lists / enumeration queries within the same section.
STUDYFLOW_EVIDENCE_EXPANSION_ENABLED=true
STUDYFLOW_EVIDENCE_NEIGHBOR_RADIUS=2
STUDYFLOW_EVIDENCE_MAX_EXTRA_CHUNKS=2
STUDYFLOW_EVIDENCE_MAX_EXTRA_TOKENS=1200
STUDYFLOW_EVIDENCE_MAX_CONTEXT_TOKENS=6000
STUDYFLOW_LLM_MODE=mock
# Set STUDYFLOW_LLM_MODE=langchain_openai for the LangChain ChatOpenAI adapter.
# openai_compatible keeps the direct HTTP adapter as a fallback.
# Both adapters use the same EvidenceContext contract and citation validation.
STUDYFLOW_LLM_BASE_URL=
# Fill with a chat model name supported by your proxy; do not use an embedding model here.
STUDYFLOW_LLM_MODEL=
# Optional dedicated chat API key. Leave blank to reuse OPENAI_API_KEY above.
STUDYFLOW_LLM_API_KEY=

# Optional local OCR: pip install -e ".[ocr]", then python -m app.rag.ocr --prepare.
# Service OCR uses prepared local models and does not download models on upload.
STUDYFLOW_OCR_ENABLED=true
STUDYFLOW_OCR_MODEL_DIR=.studyflow/ocr_models
STUDYFLOW_OCR_PDF_MIN_TEXT_CHARACTERS=40
STUDYFLOW_OCR_MAX_PAGES=30
STUDYFLOW_OCR_MAX_REGIONS_PER_PAGE=64
STUDYFLOW_OCR_DPI=180
STUDYFLOW_OCR_MAX_RENDER_PIXELS=12000000
STUDYFLOW_OCR_MAX_IMAGE_PIXELS=20000000
STUDYFLOW_OCR_MIN_CONFIDENCE=0.6

# LLM 调用控制：text 保持旧行为；json 需模型支持 JSON object。
STUDYFLOW_LLM_TIMEOUT_SECONDS=60
STUDYFLOW_LLM_MAX_RETRIES=2
STUDYFLOW_LLM_RETRY_BACKOFF_SECONDS=0.5
STUDYFLOW_LLM_MAX_OUTPUT_TOKENS=1024
STUDYFLOW_LLM_TEMPERATURE=
STUDYFLOW_LLM_ANSWER_FORMAT=text

# 文档增强问答期限；不修改长文概述的独立期限。
STUDYFLOW_ENHANCED_TIMEOUT_SECONDS=120
STUDYFLOW_RESOLUTION_TIMEOUT_SECONDS=20
# 仅支持该扩展的服务商可设 false；留空保留默认行为。
STUDYFLOW_LLM_ENABLE_THINKING=
