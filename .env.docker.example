# 复制为 .env.docker；此文件不包含真实密钥，不复用项目 B 的配置。
STUDYFLOW_LLM_MODE=mock
STUDYFLOW_LLM_BASE_URL=
STUDYFLOW_LLM_MODEL=
STUDYFLOW_LLM_API_KEY=
STUDYFLOW_LLM_TIMEOUT_SECONDS=60
STUDYFLOW_LLM_MAX_RETRIES=2
STUDYFLOW_LLM_RETRY_BACKOFF_SECONDS=0.5
STUDYFLOW_LLM_MAX_OUTPUT_TOKENS=1024
STUDYFLOW_LLM_TEMPERATURE=
STUDYFLOW_LLM_ANSWER_FORMAT=text
STUDYFLOW_VECTOR_ENABLED=false
STUDYFLOW_EMBEDDING_BASE_URL=
STUDYFLOW_EMBEDDING_MODEL=text-embedding-3-small
STUDYFLOW_EMBEDDING_API_KEY=
STUDYFLOW_RETRIEVAL_STRATEGY=bm25_idf_v2
# 模型需先显式准备，再启用 OCR 或重排；请求期间不下载模型。
STUDYFLOW_OCR_ENABLED=false
STUDYFLOW_RERANKER_ENABLED=false

# 文档增强问答期限；不修改长文概述的独立期限。
STUDYFLOW_ENHANCED_TIMEOUT_SECONDS=120
STUDYFLOW_RESOLUTION_TIMEOUT_SECONDS=20
# 仅支持该扩展的服务商可设 false；留空保留默认行为。
STUDYFLOW_LLM_ENABLE_THINKING=
